{
  "name": "skillbee-backend",
  "version": "1.0.0",
  "description": "Skillbee API — Node.js + Express, MongoDB, JWT, RBAC",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 ./tests/auth.test.js ./tests/courses.test.js ./tests/curriculum.test.js ./tests/media.test.js ./tests/quizzes.test.js ./tests/assignments.test.js ./tests/cache.test.js ./tests/enrollment.test.js ./tests/certificates.test.js ./tests/commerce.test.js ./tests/dual-payments.test.js ./tests/coupons.test.js ./tests/discount.unit.test.js ./tests/reviews.test.js ./tests/reviews.unit.test.js ./tests/qa.test.js ./tests/seo.unit.test.js ./tests/seo.test.js ./tests/seo.ssr.test.js ./tests/site-settings.test.js ./tests/notifications.test.js ./tests/email.test.js ./tests/instructor-applications.test.js ./tests/newsletter.test.js ./tests/referrals.test.js ./tests/faqs.test.js ./tests/blogs.test.js ./tests/blogs.ssr.test.js",
    "test:modules": "node --test --test-concurrency=1 ./tests/instructor-applications.test.js ./tests/newsletter.test.js ./tests/referrals.test.js ./tests/faqs.test.js ./tests/blogs.test.js ./tests/blogs.ssr.test.js",
    "test:qa": "node --test --test-concurrency=1 ./tests/qa.test.js",
    "test:seo": "node --test --test-concurrency=1 ./tests/seo.unit.test.js ./tests/seo.test.js ./tests/seo.ssr.test.js",
    "test:phase13": "node --test --test-concurrency=1 ./tests/qa.test.js ./tests/seo.unit.test.js ./tests/seo.test.js ./tests/seo.ssr.test.js",
    "test:phase14": "node --test --test-concurrency=1 ./tests/site-settings.test.js",
    "test:phase15": "node --test --test-concurrency=1 ./tests/notifications.test.js ./tests/email.test.js",
    "test:phase14-15": "node --test --test-concurrency=1 ./tests/site-settings.test.js ./tests/notifications.test.js ./tests/email.test.js",
    "worker:email": "node src/workers/email.worker.js",
    "test:enrollment": "node --test --test-concurrency=1 ./tests/enrollment.test.js",
    "test:certificates": "node --test --test-concurrency=1 ./tests/certificates.test.js",
    "test:commerce": "node --test --test-concurrency=1 ./tests/commerce.test.js ./tests/dual-payments.test.js ./tests/coupons.test.js ./tests/discount.unit.test.js",
    "test:payments": "node --test --test-concurrency=1 ./tests/dual-payments.test.js",
    "test:coupons": "node --test --test-concurrency=1 ./tests/discount.unit.test.js ./tests/coupons.test.js",
    "test:reviews": "node --test --test-concurrency=1 ./tests/reviews.unit.test.js ./tests/reviews.test.js",
    "seed:enrollment": "node src/scripts/seedEnrollment.js",
    "seed:certificates": "node src/scripts/seedCertificates.js",
    "bench:cache": "node scripts/bench-cache.mjs",
    "seed:permissions": "node src/scripts/seedRoles.js",
    "seed:roles": "node src/scripts/seedRoles.js",
    "seed:curriculum": "node src/scripts/seedCurriculum.js",
    "seed:quizzes": "node src/scripts/seedQuizzes.js",
    "seed:assignments": "node src/scripts/seedAssignments.js",
    "seed:newsletter": "node src/scripts/seedNewsletter.js",
    "seed:faqs": "node src/scripts/seedFaqs.js",
    "seed:blogs": "node src/scripts/seedBlogs.js",
    "seed:seo": "node src/scripts/seedSeo.js",
    "seed:comms": "node src/scripts/seedComms.js",
    "validate:openapi": "node src/scripts/validateOpenApi.js",
    "e2e:curriculum": "node scripts/e2e-curriculum-check.mjs",
    "e2e:media": "node scripts/e2e-media-check.mjs",
    "e2e:quizzes": "node scripts/e2e-quiz-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "mongodb",
    "jwt",
    "rbac"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.5.4",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.18.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  }
}

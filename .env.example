NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Atlas connection string
# Prefer mongodb+srv:// when DNS SRV works. If you get querySrv ECONNREFUSED,
# use the standard mongodb:// URI from Atlas (Connect → Drivers → Drivers 3.6+ / non-SRV).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillbee?retryWrites=true&w=majority

# JWT — use long random secrets in production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies / CORS (comma-separated origins)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Password reset
PASSWORD_RESET_EXPIRES_MINUTES=30

# Optional: create first super admin via npm run seed:roles
# SEED_SUPER_ADMIN_EMAIL=admin@skillbee.local
# SEED_SUPER_ADMIN_PASSWORD=ChangeMe123
# SEED_SUPER_ADMIN_NAME=Super Admin

# Media storage (images → Cloudinary; videos/docs → VPS disk outside web root)
UPLOAD_ROOT=./uploads
TEMP_UPLOAD_ROOT=./uploads/temporary
IMAGE_MAX_SIZE_MB=10
DOCUMENT_MAX_SIZE_MB=50
MAX_DOCUMENT_SIZE_MB=50
VIDEO_MAX_SIZE_MB=2048
MAX_VIDEO_SIZE_MB=2048
MAX_STORAGE_USAGE_PERCENT=85
UPLOAD_SESSION_TTL_MINUTES=30
STORAGE_STATS_CACHE_SECONDS=60
ALLOW_PUBLISH_WITHOUT_LESSONS=false
# When true, students must complete the course before submitting a review
REVIEW_REQUIRE_COURSE_COMPLETION=false
# When true, uploaded videos stay pending until an external FFmpeg/HLS worker marks ready.
VIDEO_HLS_ENABLED=false
# PLAYBACK_TOKEN_SECRET=optional-override-min-32-chars-long!!
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=skillbee

# Redis cache (optional). APIs work when Redis is down or disabled.
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Leave empty for local Redis without auth; set a password in production
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillbee:
REDIS_CONNECT_TIMEOUT_MS=3000

# Certificates (public verify URL base should include API prefix in production)
PUBLIC_API_BASE_URL=
CERTIFICATE_NUMBER_PREFIX=SKB
CERTIFICATE_VERIFY_PATH=/certificates/verify

# Course commerce / dual payment gateways (never commit real credentials)
PAYMENT_CURRENCY=INR
PAYMENT_DEFAULT_GATEWAY=razorpay
ORDER_NUMBER_PREFIX=SKB-ORD
INVOICE_NUMBER_PREFIX=SKB-INV
FRONTEND_BASE_URL=
BACKEND_PUBLIC_URL=

# Razorpay – Indian payments
RAZORPAY_ENABLED=true
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# PayPal – International payments
PAYPAL_ENABLED=true
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# Trusted FX rate (USD major per 1 INR major). Empty = no auto-conversion.
PAYMENT_FX_INR_TO_USD=

# AES-256-GCM master key for encrypting gateway secrets at rest (32+ chars)
PAYMENT_SECRET_ENCRYPTION_KEY=

# When true, completed refunds may revoke enrollment by default (admin can override per refund)
REFUND_REVOKE_ENROLLMENT_DEFAULT=false

# Firebase Admin SDK (FCM) — never commit real credentials
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Escape newlines as \n in .env
FIREBASE_PRIVATE_KEY=
# OR place JSON at ./secrets/firebase-service-account.json and set path:
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# Hostinger SMTP — never commit mailbox password
EMAIL_ENABLED=false
EMAIL_QUEUE_ENABLED=true
EMAIL_RETRY_LIMIT=3
EMAIL_FRONTEND_URL=
EMAIL_INLINE_WORKER=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SkillBee
SMTP_FROM_EMAIL=

# Public site URL for SEO / canonicals (defaults to FRONTEND_BASE_URL)
PUBLIC_SITE_URL=
COURSE_PUBLIC_PATH_PREFIX=/courses
